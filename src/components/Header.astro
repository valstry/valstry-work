---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">Valstry <span>· 知识库</span></a>
    <nav class="nav" aria-label="主导航">
      <a href="/" aria-current={current === "home" ? "page" : undefined}>图谱</a>
      <a href="/posts/" aria-current={current === "posts" ? "page" : undefined}>笔记</a>
      <a href="/tools/" aria-current={current === "tools" ? "page" : undefined}>工具</a>
      <a href="/about/" aria-current={current === "about" ? "page" : undefined}>关于</a>
    </nav>
  </div>
</header>
