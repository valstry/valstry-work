---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
  fullBleed?: boolean;
}
const {
  title,
  description = "Valstry 知识库 —— 个人学习笔记与工具合集，以关系图谱浏览。",
  current,
  fullBleed = false,
} = Astro.props;
const fullTitle =
  title === "Valstry · 知识库" || title === "Valstry Work"
    ? "Valstry · 知识库"
    : `${title} · Valstry 知识库`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Valstry 知识库" href="/rss.xml" />
    <title>{fullTitle}</title>
  </head>
  <body class:list={[{ "body--graph": fullBleed }]}>
    <Header current={current} />
    <main class:list={[{ "main--bleed": fullBleed }]}>
      <slot />
    </main>
    {!fullBleed && <Footer />}
  </body>
</html>
