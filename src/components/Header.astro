---
interface Props {
  current?: string;
}
const { current } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/">Valstry <span>· 教程</span></a>
    <nav class="nav" aria-label="主导航">
      <a href="/" aria-current={current === "home" ? "page" : undefined}>首页</a>
      <a href="/posts/" aria-current={current === "posts" ? "page" : undefined}>文章</a>
      <a href="/about/" aria-current={current === "about" ? "page" : undefined}>关于</a>
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</header>
