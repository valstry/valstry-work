---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  current?: string;
}
const {
  title,
  description = "Valstry Work —— AI 与自动化工具教程、干货与实践笔记。",
  current,
} = Astro.props;
const fullTitle = title === "Valstry Work" ? title : `${title} · Valstry Work`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Valstry Work" href="/rss.xml" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <Header current={current} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
