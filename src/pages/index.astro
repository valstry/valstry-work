---
import BaseLayout from "../layouts/BaseLayout.astro";
import { buildGraphData } from "../lib/graph";

const graph = await buildGraphData();
const noteCount = graph.nodes.filter((n) => n.type === "note").length;
const toolCount = graph.nodes.filter((n) => n.type === "tool").length;
---
<BaseLayout
  title="Valstry · 知识库"
  description="Valstry 个人知识库：笔记与外部工具的关系图谱导航。"
  current="home"
  fullBleed
>
  <div class="graph-home">
    <aside class="graph-legend" aria-label="图例与提示">
      <h1>Valstry · 知识库</h1>
      <p class="graph-legend__desc">
        学习笔记与常用工具的关系图。拖动节点、滚轮/双指缩放；点击笔记进入页面，点击工具打开外链。
      </p>
      <ul class="graph-legend__keys">
        <li><span class="swatch swatch--note"></span>笔记 {noteCount}</li>
        <li><span class="swatch swatch--tool"></span>工具 {toolCount}</li>
      </ul>
      <p class="graph-legend__fallback">
        手机不便操作？也可打开
        <a href="/posts/">笔记列表</a>
        或
        <a href="/tools/">工具列表</a>。
      </p>
    </aside>

    <div class="graph-stage" role="application" aria-label="知识关系图">
      <canvas id="wiki-graph"></canvas>
      <div id="graph-tooltip" class="graph-tooltip" hidden></div>
    </div>
  </div>

  <script id="wiki-graph-data" type="application/json" set:html={JSON.stringify(graph)} />
  <script src="../scripts/force-graph.ts"></script>
</BaseLayout>
