---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  href: string;
  tags?: string[];
}
const { title, description, pubDate, href, tags = [] } = Astro.props;
const date = pubDate.toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---
<a class="post-card" href={href}>
  <div class="post-meta">
    <time datetime={pubDate.toISOString()}>{date}</time>
    {tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
</a>
